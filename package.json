{
	"name": "wp-admin-redesign-exploration",
	"version": "1.0.0",
	"description": "Exploratory plugin for WordPress admin visual refresh using forked core stylesheets.",
	"scripts": {
		"wp-env": "wp-env",
		"build:colors": "sass core-styles/wp-admin/css/colors/modern/colors.scss:core-styles/wp-admin/css/colors/modern/colors.css core-styles/wp-admin/css/colors/light/colors.scss:core-styles/wp-admin/css/colors/light/colors.css core-styles/wp-admin/css/colors/blue/colors.scss:core-styles/wp-admin/css/colors/blue/colors.css core-styles/wp-admin/css/colors/coffee/colors.scss:core-styles/wp-admin/css/colors/coffee/colors.css core-styles/wp-admin/css/colors/ectoplasm/colors.scss:core-styles/wp-admin/css/colors/ectoplasm/colors.css core-styles/wp-admin/css/colors/midnight/colors.scss:core-styles/wp-admin/css/colors/midnight/colors.css core-styles/wp-admin/css/colors/ocean/colors.scss:core-styles/wp-admin/css/colors/ocean/colors.css core-styles/wp-admin/css/colors/sunrise/colors.scss:core-styles/wp-admin/css/colors/sunrise/colors.css --style=expanded --no-source-map",
		"build:colors:rtl": "rtlcss core-styles/wp-admin/css/colors/modern/colors.css core-styles/wp-admin/css/colors/modern/colors-rtl.css && rtlcss core-styles/wp-admin/css/colors/light/colors.css core-styles/wp-admin/css/colors/light/colors-rtl.css && rtlcss core-styles/wp-admin/css/colors/blue/colors.css core-styles/wp-admin/css/colors/blue/colors-rtl.css && rtlcss core-styles/wp-admin/css/colors/coffee/colors.css core-styles/wp-admin/css/colors/coffee/colors-rtl.css && rtlcss core-styles/wp-admin/css/colors/ectoplasm/colors.css core-styles/wp-admin/css/colors/ectoplasm/colors-rtl.css && rtlcss core-styles/wp-admin/css/colors/midnight/colors.css core-styles/wp-admin/css/colors/midnight/colors-rtl.css && rtlcss core-styles/wp-admin/css/colors/ocean/colors.css core-styles/wp-admin/css/colors/ocean/colors-rtl.css && rtlcss core-styles/wp-admin/css/colors/sunrise/colors.css core-styles/wp-admin/css/colors/sunrise/colors-rtl.css",
		"build": "npm run build:colors && npm run build:colors:rtl",
		"watch": "sass --watch core-styles/wp-admin/css/colors/modern/colors.scss:core-styles/wp-admin/css/colors/modern/colors.css core-styles/wp-admin/css/colors/light/colors.scss:core-styles/wp-admin/css/colors/light/colors.css core-styles/wp-admin/css/colors/blue/colors.scss:core-styles/wp-admin/css/colors/blue/colors.css core-styles/wp-admin/css/colors/coffee/colors.scss:core-styles/wp-admin/css/colors/coffee/colors.css core-styles/wp-admin/css/colors/ectoplasm/colors.scss:core-styles/wp-admin/css/colors/ectoplasm/colors.css core-styles/wp-admin/css/colors/midnight/colors.scss:core-styles/wp-admin/css/colors/midnight/colors.css core-styles/wp-admin/css/colors/ocean/colors.scss:core-styles/wp-admin/css/colors/ocean/colors.css core-styles/wp-admin/css/colors/sunrise/colors.scss:core-styles/wp-admin/css/colors/sunrise/colors.css --style=expanded --no-source-map",
		"capture:admin-pages": "node scripts/capture-admin-pages.js",
		"capture:screenshots": "node scripts/capture-screenshots.js",
		"capture:real": "node scripts/capture-real-screenshots.js",
		"capture:storybook": "node scripts/capture-storybook-screenshots.js",
		"sync:init": "bash scripts/init-fork.sh",
		"sync:update": "bash scripts/sync-from-core.sh",
		"sync:status": "bash scripts/sync-status.sh",
		"sync:to-core": "bash scripts/sync-to-core.sh"
	},
	"engines": {
		"node": ">=20.0.0"
	},
	"dependencies": {
		"@wordpress/env": "^10.16.0",
		"playwright": "^1.57.0",
		"rtlcss": "^4.3.0",
		"sass": "^1.83.0"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/fabiankaegy/wp-admin-redesign-exploration.git"
	},
	"author": "Fabian Kägy",
	"license": "GPL-2.0-or-later",
	"bugs": {
		"url": "https://github.com/fabiankaegy/wp-admin-redesign-exploration/issues"
	},
	"homepage": "https://github.com/fabiankaegy/wp-admin-redesign-exploration#readme"
}
