# Admin Redesign Exploration - Environment Configuration
#
# Copy this file to .env and configure for your local environment.
# The .env file is gitignored and won't be committed.

# Path to WordPress core repository (wordpress-develop)
# Can be absolute or relative to this plugin directory
CORE_REPO_PATH=../wordpress-develop

# Branch to sync from (usually "trunk")
CORE_BRANCH=trunk
