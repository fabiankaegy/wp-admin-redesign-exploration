{
	"name": "wp-admin-redesign-exploration",
	"version": "1.0.0",
	"scripts": {
		"start": "npm run watch",
		"watch": "10up-toolkit watch --port=5015",
		"build": "10up-toolkit build",
		"format-js": "10up-toolkit format-js",
		"lint-js": "10up-toolkit lint-js",
		"lint-style": "10up-toolkit lint-style",
		"test": "10up-toolkit test-unit-jest",
		"clean-dist": "rm -rf ./dist",
		"scaffold:block": "cd includes/blocks/ && wp-create-block --no-plugin --template ../../../../bin/create-block-template",
		"wp-env": "wp-env",
		"capture:admin-pages": "node scripts/capture-admin-pages.js",
		"capture:screenshots": "node scripts/capture-screenshots.js",
		"capture:real": "node scripts/capture-real-screenshots.js",
		"capture:storybook": "node scripts/capture-storybook-screenshots.js",
		"sync:init": "bash scripts/init-fork.sh",
		"sync:update": "bash scripts/sync-from-core.sh",
		"sync:status": "bash scripts/sync-status.sh",
		"sync:to-core": "bash scripts/sync-to-core.sh"
	},
	"engines": {
		"node": ">=20.0.0"
	},
	"dependencies": {
		"@wordpress/env": "^10.16.0",
		"10up-toolkit": "^6.4.0",
		"playwright": "^1.57.0"
	},
	"10up-toolkit": {
		"useBlockAssets": true,
		"useScriptModules": true,
		"entry": {
			"admin-redesign": "./assets/css/admin-redesign.css",
			"admin-enhancements": "./assets/js/admin-enhancements.js"
		}
	},
	"description": "Contributors: fabiankaegy Requires at least: 6.7 Tested up to: 6.7.1 Stable tag: 0.1.0 Requires PHP: 8.0 License: GPLv2 or later License URI: <https://www.gnu.org/licenses/gpl-2.0.html>",
	"main": "capture-screenshots.js",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/fabiankaegy/wp-admin-redesign-exploration.git"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"bugs": {
		"url": "https://github.com/fabiankaegy/wp-admin-redesign-exploration/issues"
	},
	"homepage": "https://github.com/fabiankaegy/wp-admin-redesign-exploration#readme"
}
